:\"address\"},{\"internalType\":\"uint256\",\"name\":\"nonce\",\"type\":\"uint256\"},{\"internalType\":\"uint32\",\"name\":\"originChainId\",\"type\":\"uint32\"},{\"internalType\":\"uint32\",\"name\":\"initiateDeadline\",\"type\":\"uint32\"},{\"internalType\":\"uint32\",\"name\":\"fillDeadline\",\"type\":\"uint32\"},{\"internalType\":\"bytes\",\"name\":\"orderData\",\"type\":\"bytes\"}],\"internalType\":\"struct EswapRouter.CrossChainOrder\",\"name\":\"order\",\"type\":\"tuple\"},{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"name\":\"resolve\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"settlementContract\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"swapper\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"nonce\",\"type\":\"uint256\"},{\"internalType\":\"uint32\",\"name\":\"originChainId\",\"type\":\"uint32\"},{\"internalType\":\"uint32\",\"name\":\"initiateDeadline\",\"type\":\"uint32\"},{\"internalType\":\"uint32\",\"name\":\"fillDeadline\",\"type\":\"uint32\"},{\"components\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"internalType\":\"struct EswapRouter.Input[]\",\"name\":\"swapperInputs\",\"type\":\"tuple[]\"},{\"components\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint32\",\"name\":\"chainId\",\"type\":\"uint32\"},{\"internalType\":\"address\",\"name\":\"recipient\",\"type\":\"address\"}],\"internalType\":\"struct EswapRouter.Output[]\",\"name\":\"swapperOutputs\",\"type\":\"tuple[]\"}],\"internalType\":\"struct EswapRouter.ResolvedCrossChainOrder\",\"name\":\"resolved\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"components\":[{\"components\":[{\"internalType\":\"Currency\",\"name\":\"currency0\",\"type\":\"address\"},{\"internalType\":\"Currency\",\"name\":\"currency1\",\"type\":\"address\"},{\"internalType\":\"uint24\",\"name\":\"fee\",\"type\":\"uint24\"},{\"internalType\":\"int24\",\"name\":\"tickSpacing\",\"type\":\"int24\"},{\"internalType\":\"address\",\"name\":\"hooks\",\"type\":\"address\"}],\"internalType\":\"struct PoolKey\",\"name\":\"key\",\"type\":\"tuple\"},{\"components\":[{\"internalType\":\"Currency\",\"name\":\"currency0\",\"type\":\"address\"},{\"internalType\":\"Currency\",\"name\":\"currency1\",\"type\":\"address\"},{\"internalType\":\"uint24\",\"name\":\"fee\",\"type\":\"uint24\"},{\"internalType\":\"int24\",\"name\":\"tickSpacing\",\"type\":\"int24\"},{\"internalType\":\"address\",\"name\":\"hooks\",\"type\":\"address\"}],\"internalType\":\"struct PoolKey\",\"name\":\"standardPoolKey\",\"type\":\"tuple\"},{\"internalType\":\"bool\",\"name\":\"zeroForOne\",\"type\":\"bool\"},{\"internalType\":\"int256\",\"name\":\"amountSpecified\",\"type\":\"int256\"},{\"internalType\":\"uint8\",\"name\":\"leverage\",\"type\":\"uint8\"},{\"internalType\":\"address\",\"name\":\"solver\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"hookData\",\"type\":\"bytes\"}],\"internalType\":\"struct EswapRouter.SwapParams\",\"name\":\"params\",\"type\":\"tuple\"}],\"name\":\"swap\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"unlockCallback\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"SDIM (Solver-Delegated Integration Margin) single-pool execution:      there is exactly ONE hook-enabled pool. Inside the unlock callback the      router:        1. Executes the margin swap on the hook pool with `hookData`           (the hook flash-expands the swap by the borrow and records the           position in afterSwap).        2. Pulls the trader's MARGIN and settles it (router's -margin delta).        3. Mints the swap OUTPUT as an ERC-6909 claim held by the HOOK           (collateral custodian), offsetting the router's +output delta.        4. Pulls the SOLVER's borrow and settles it FOR THE HOOK via           settleFor(hook), zeroing the hook's flash-provided -borrow delta.        5. Registers the on-chain SolverDebt guaranteeing solver repayment.      All (account, currency) transient deltas net to zero before unlock exits.\",\"errors\":{\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\"}],\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\"}]},\"kind\":\"dev\",\"methods\":{\"acceptOwnership()\":{\"details\":\"The new owner accepts the ownership transfer.\"},\"liquidate(address,(address,address,uint24,int24,address),address,uint256)\":{\"details\":\"Anyone may trigger the liquidation of an underwater position. The hook      validates the position is actually liquidatable and enforces slippage      via minAmountOut, so permissionless access cannot force bad liquidations.\",\"params\":{\"minAmountOut\":\"Minimum swap output for the liquidation unwind (slippage                     protection against MEV); derive it from an oracle quote.\"}},\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"pendingOwner()\":{\"details\":\"Returns the address of the pending owner.\"},\"quoteExactInput((address,address,uint24,int24,address),bool,int128,uint8)\":{\"details\":\"Spot-depth approximation based on the real on-chain slot0 price.\"},\"rebalance(address,(address,address,uint24,int24,address),address)\":{\"details\":\"Re-centers an out-of-range position's concentrated liquidity around the      current tick. Safe to run permissionless: it only moves liquidity ranges,      is a no-op when the tick is already in range, and the caller pays gas.\"},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"transferOwnership(address)\":{\"details\":\"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer.\"}},\"title\":\"EswapRouter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"initiate((address,address,uint256,uint32,uint32,uint32,bytes),bytes,bytes)\":{\"notice\":\"ERC-7683 Solver Initiation Gateway. Allows permissionless solvers to fill the trader's off-chain signed intent order.\"},\"liquidate(address,(address,address,uint24,int24,address),address,uint256)\":{\"notice\":\"Permissionless liquidation entrypoint for keepers.\"},\"quoteExactInput((address,address,uint24,int24,address),bool,int128,uint8)\":{\"notice\":\"Quoter-to-execution parity view helper for ODOS/Enso aggregators.\"},\"rebalance(address,(address,address,uint24,int24,address),address)\":{\"notice\":\"Permissionless rebalancing entrypoint for keepers.\"},\"resolve((address,address,uint256,uint32,uint32,uint32,bytes),bytes)\":{\"notice\":\"ERC-7683 Order Resolution Interface. Decodes the cross-chain order's custom parameters for solvers/aggregators to inspect inputs/outputs.\"}},\"notice\":\"Handles Uniswap V4 unlock flow for the SDIM margin model.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/v4/EswapRouter.sol\":\"EswapRouter\"},