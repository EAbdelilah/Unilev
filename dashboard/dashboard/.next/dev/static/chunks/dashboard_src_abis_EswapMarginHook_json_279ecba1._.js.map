,\"name\":\"\",\"type\":\"bytes\"}],\"name\":\"swapToPrice\",\"outputs\":[{\"internalType\":\"int128\",\"name\":\"\",\"type\":\"int128\"},{\"internalType\":\"int128\",\"name\":\"\",\"type\":\"int128\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"tokenDecimals\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"Currency\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"totalBorrowedByToken\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"Currency\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"totalCollateral\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalCollateralUSDRunning\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalOpenInterestUSD\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"receiver\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"transfer\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"sender\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"receiver\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"transferFrom\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"treasury\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"unlockCallback\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"Currency\",\"name\":\"currency\",\"type\":\"address\"}],\"name\":\"withdrawAllProtocolFees\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"Currency\",\"name\":\"currency\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"withdrawInsuranceFund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"Currency\",\"name\":\"currency\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"withdrawProtocolFee\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"SDIM execution model: the hook is a registry + ERC-6909 collateral      custodian. No protocol vaults exist. An off-chain Solver physically      settles the borrowed leg (margin x (leverage-1)) inside the router's      unlock callback; the hook guarantees Solver repayment (principal + yield)      via the on-chain `solverDebts` registry before the trader can withdraw.      The PoolManager API is the REAL lib/v4-core ABI: extsload for the packed      slot0, exttload for transient currency deltas, no-arg settle().\",\"errors\":{\"SafeCastOverflowedIntDowncast(uint8,int256)\":[{\"details\":\"Value doesn't fit in an int of `bits` size.\"}],\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"events\":{\"HookSwap(bytes32,address,int128,int128,uint256)\":{\"params\":{\"amount0\":\"The delta of token0.\",\"amount1\":\"The delta of token1.\",\"hookFee\":\"The fee collected by the hook.\",\"poolId\":\"The ID of the pool.\",\"sender\":\"The address that triggered the swap.\"}}},\"kind\":\"dev\",\"methods\":{\"executeArbunDelivery((address,address,uint24,int24,address),address)\":{\"details\":\"Fulfills the Shariah Arbun requirement (Qabd) by physically swapping on standardPoolKey.\"},\"executeLiquidation((address,address,uint24,int24,address),address,uint256)\":{\"params\":{\"key\":\"The Uniswap V4 pool key.\",\"minAmountOut\":\"Minimum tokens the swap must return (slippage protection against MEV).                     The caller (liquidation bot) should derive this from an oracle quote.\",\"trader\":\"The trader whose position will be liquidated.\"}},\"liquidationThresholdBps(uint8)\":{\"details\":\"Threshold decreases as leverage increases, giving higher-leverage positions more      breathing room before liquidation \\u2014 improving UX and margin aggregator risk scores.      Formula: 120% - (leverage \\u00d7 2%), so higher leverage is more forgiving:        2x \\u2192 116%,  3x \\u2192 114%,  5x \\u2192 110%,  10x \\u2192 100% (hard floor).      The result is floored at 10000 (100%) to always require positive collateral.\"},\"positionCurrencies((address,address,uint24,int24,address),address)\":{\"details\":\"Needed by off-chain/keeper consumers because `isLong` is anchored to the      pool's configured base currency (see setBaseCurrency) and therefore no      longer maps 1:1 to currency0.\"},\"setBaseCurrency(bytes32,address)\":{\"details\":\"Determines the meaning of the reported `isLong` flag: a position whose      collateral is the base token is LONG, otherwise SHORT. Defaults to      currency0 when unset. On Unichain (currency0=USDC, currency1=WETH) set      this to WETH so \\\"long WETH\\\" positions report isLong=true.\"},\"setMaxLeverageForPool(bytes32,uint8)\":{\"details\":\"Allows higher leverage on deeper, more liquid pools (e.g. 10x on a      high-TVL WETH/USDC pool) without changing the global default.      Set to 0 to revert to defaultMaxLeverage.\"},\"setMaxPriceSwingBps(uint160)\":{\"details\":\"Increase during high-volatility periods to prevent valid trades reverting      and hurting the protocol's aggregator success-rate score.      Hard ceiling of 2000 bps (20%) prevents disabling the circuit breaker entirely.\"},\"setRequireTwapOracle(bool)\":{\"details\":\"Set to true before mainnet deployment. Leaving false allows testing without      a live Chainlink feed (e.g., local Anvil forks).\"},\"setTokenDecimals(address,uint8)\":{\"details\":\"Required for pools containing non-18-decimal tokens (e.g. 6-decimal USDC)      so the V4-spot vs V3-TWAP circuit breaker compares like-for-like prices.      Unconfigured tokens are assumed to be 18 decimals.\"}},\"title\":\"EswapMarginHook\",\"version\":1},\"userdoc\":{\"events\":{\"HookSwap(bytes32,address,int128,int128,uint256)\":{\"notice\":\"Emitted when a hook-facilitated swap occurs.\"}},\"kind\":\"user\",\"methods\":{\"closePosition((address,address,uint24,int24,address),address,address,uint256)\":{\"notice\":\"Closes a leveraged margin position, settling solver debt and returning profit.\"},\"deployCollateral((address,address,uint24,int24,address),address)\":{\"notice\":\"STEP 3: Smart Collateral Rehypothecation (0% Interest) Deploy the entire collateral as concentrated liquidity to harvest fees. Called by the Router AFTER the swap to avoid re-entrancy locks.\"},\"executeArbunDelivery((address,address,uint24,int24,address),address)\":{\"notice\":\"Converts a synthetic Arbun position into physical asset delivery on Uniswap V4.\"},\"executeLiquidation((address,address,uint24,int24,address),address,uint256)\":{\"notice\":\"Executes a forced liquidation of an underwater position.\"},\"getHookTVL(address)\":{\"notice\":\"Returns the total value locked within the hook for a specific currency.\"},\"getSwappableCapacity(address)\":{\"notice\":\"Returns the immediately swappable liquidity (capacity) of the hook.\"},\"getTotalCollateralUSD()\":{\"notice\":\"Returns a real protocol-wide collateral aggregate in USD.\"},\"getTotalDebtUSD()\":{\"notice\":\"Returns a real protocol-wide borrow aggregate in USD.\"},\"liquidationThresholdBps(uint8)\":{\"notice\":\"Returns the dynamic liquidation threshold for a position in basis points of collateralization.\"},\"positionCurrencies((address,address,uint24,int24,address),address)\":{\"notice\":\"Resolves the collateral and debt currencies for a trader's position.\"},\"registerSolverDebt(bytes32,address,address,uint256)\":{\"notice\":\"Registers solver debt when a leveraged margin position is opened. The solver physically settled the borrowed leg inside the router's unlock callback; this registry guarantees its repayment (principal + yield) before the trader can withdraw on close/liquidation.\"},\"seedInsuranceFund(address,uint256)\":{\"notice\":\"Seed the insurance fund using physical ERC20s, converting them to 6909s.\"},\"setBaseCurrency(bytes32,address)\":{\"notice\":\"Configures the base (underlying) token for a pool.\"},\"setDefaultMaxLeverage(uint8)\":{\"notice\":\"Updates the global default maximum leverage.\"},\"setMaxLeverageForPool(bytes32,uint8)\":{\"notice\":\"Sets the maximum leverage allowed for a specific pool.\"},\"setMaxPriceSwingBps(uint160)\":{\"notice\":\"Adjusts the TWAP circuit-breaker tolerance.\"},\"setRequireTwapOracle(bool)\":{\"notice\":\"[FIX H-1] Toggle mandatory TWAP oracle enforcement.\"},\"setReserveFactor(uint256)\":{\"notice\":\"Allows the owner to dynamically lower or adjust the reserve fee to compete with aggregators. Maximum safety ceiling is set to 100 basis points (1.0%) to protect traders.\"},\"setTokenDecimals(address,uint8)\":{\"notice\":\"Configures the ERC-20 decimals for a pool token.\"},\"withdrawAllProtocolFees(address)\":{\"notice\":\"Withdraws all protocol fees for a given currency to the treasury.\"},\"withdrawInsuranceFund(address,address,uint256)\":{\"notice\":\"Withdraws physically settled tokens from the Insurance Fund.\"},\"withdrawProtocolFee(address,uint256)\":{\"notice\":\"Withdraws accumulated protocol fees to the treasury address.\"}},\"notice\":\"The \\\"End-Game\\\" V4 hook addressing TVL and User Acquisition via: 1. EIP-1153 Flash Borrowing (Solves TVL bottleneck by utilizing AMM reserves) 2. Treasury-Assisted Settlement (Enables multi-day 0% interest positions) 3. Standardized URC Compliance (Solves User Acquisition via Solver/Aggregator routing)\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/v4/EswapMarginHook.sol\":\"EswapMarginHook\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":20000},\"remappings\":[\":@chainlink/=lib/chainlink-brownie-contracts/\",\":@clones/=lib/clones-with-immutable-args/src/\",\":@ensdomains/=lib/v4-core/node_modules/@ensdomains/\",\":@openzeppelin/=lib/openzeppelin-contracts/\",\":@std/=lib/forge-std/src/\",\":@uniswap/v4-core/=lib/v4-core/\",\":chainlink-brownie-contracts/=lib/chainlink-brownie-contracts/\",\":ds-test/=lib/v4-core/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":hardhat/=lib/v4-core/node_modules/hardhat/\",\":openzeppelin-contracts/=lib/openzeppelin-contracts/\",\":solmate/=lib/v4-core/lib/solmate/\",\":v4-core/=lib/v4-core/src/\"],\"viaIR\":true},\"sources\":{\"lib/openzeppelin-contracts/contracts/interfaces/IERC1363.sol\":{\"keccak256\":\"0xd5ea07362ab630a6a3dee4285a74cf2377044ca2e4be472755ad64d7c5d4b69d\",\"license\