e":"uint24","name":"fee","type":"uint24"},{"internalType":"int24","name":"tickSpacing","type":"int24"},{"internalType":"address","name":"hooks","type":"address"}]},{"internalType":"uint160","name":"","type":"uint160"},{"internalType":"bytes","name":"","type":"bytes"}],"stateMutability":"pure","type":"function","name":"swapToPrice","outputs":[{"internalType":"int128","name":"","type":"int128"},{"internalType":"int128","name":"","type":"int128"}]},{"inputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function","name":"tokenDecimals","outputs":[{"internalType":"uint8","name":"","type":"uint8"}]},{"inputs":[{"internalType":"Currency","name":"","type":"address"}],"stateMutability":"view","type":"function","name":"totalBorrowedByToken","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"Currency","name":"","type":"address"}],"stateMutability":"view","type":"function","name":"totalCollateral","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"totalCollateralUSDRunning","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"totalOpenInterestUSD","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"address","name":"receiver","type":"address"},{"internalType":"uint256","name":"id","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"transfer","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[{"internalType":"address","name":"sender","type":"address"},{"internalType":"address","name":"receiver","type":"address"},{"internalType":"uint256","name":"id","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"transferFrom","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"treasury","outputs":[{"internalType":"address","name":"","type":"address"}]},{"inputs":[{"internalType":"bytes","name":"data","type":"bytes"}],"stateMutability":"nonpayable","type":"function","name":"unlockCallback","outputs":[{"internalType":"bytes","name":"","type":"bytes"}]},{"inputs":[{"internalType":"Currency","name":"currency","type":"address"}],"stateMutability":"nonpayable","type":"function","name":"withdrawAllProtocolFees"},{"inputs":[{"internalType":"Currency","name":"currency","type":"address"},{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"withdrawInsuranceFund"},{"inputs":[{"internalType":"Currency","name":"currency","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"withdrawProtocolFee"}],"devdoc":{"kind":"dev","methods":{"executeArbunDelivery((address,address,uint24,int24,address),address)":{"details":"Fulfills the Shariah Arbun requirement (Qabd) by physically swapping on standardPoolKey."},"executeLiquidation((address,address,uint24,int24,address),address,uint256)":{"params":{"key":"The Uniswap V4 pool key.","minAmountOut":"Minimum tokens the swap must return (slippage protection against MEV).                     The caller (liquidation bot) should derive this from an oracle quote.","trader":"The trader whose position will be liquidated."}},"liquidationThresholdBps(uint8)":{"details":"Threshold decreases as leverage increases, giving higher-leverage positions more      breathing room before liquidation — improving UX and margin aggregator risk scores.      Formula: 120% - (leverage × 2%), so higher leverage is more forgiving:        2x → 116%,  3x → 114%,  5x → 110%,  10x → 100% (hard floor).      The result is floored at 10000 (100%) to always require positive collateral."},"positionCurrencies((address,address,uint24,int24,address),address)":{"details":"Needed by off-chain/keeper consumers because `isLong` is anchored to the      pool's configured base currency (see setBaseCurrency) and therefore no      longer maps 1:1 to currency0."},"setBaseCurrency(bytes32,address)":{"details":"Determines the meaning of the reported `isLong` flag: a position whose      collateral is the base token is LONG, otherwise SHORT. Defaults to      currency0 when unset. On Unichain (currency0=USDC, currency1=WETH) set      this to WETH so \"long WETH\" positions report isLong=true."},"setMaxLeverageForPool(bytes32,uint8)":{"details":"Allows higher leverage on deeper, more liquid pools (e.g. 10x on a      high-TVL WETH/USDC pool) without changing the global default.      Set to 0 to revert to defaultMaxLeverage."},"setMaxPriceSwingBps(uint160)":{"details":"Increase during high-volatility periods to prevent valid trades reverting      and hurting the protocol's aggregator success-rate score.      Hard ceiling of 2000 bps (20%) prevents disabling the circuit breaker entirely."},"setRequireTwapOracle(bool)":{"details":"Set to true before mainnet deployment. Leaving false allows testing without      a live Chainlink feed (e.g., local Anvil forks)."},"setTokenDecimals(address,uint8)":{"details":"Required for pools containing non-18-decimal tokens (e.g. 6-decimal USDC)      so the V4-spot vs V3-TWAP circuit breaker compares like-for-like prices.      Unconfigured tokens are assumed to be 18 decimals."}},"version":1},"userdoc":{"kind":"user","methods":{"closePosition((address,address,uint24,int24,address),address,address,uint256)":{"notice":"Closes a leveraged margin position, settling solver debt and returning profit."},"deployCollateral((address,address,uint24,int24,address),address)":{"notice":"STEP 3: Smart Collateral Rehypothecation (0% Interest) Deploy the entire collateral as concentrated liquidity to harvest fees. Called by the Router AFTER the swap to avoid re-entrancy locks."},"executeArbunDelivery((address,address,uint24,int24,address),address)":{"notice":"Converts a synthetic Arbun position into physical asset delivery on Uniswap V4."},"executeLiquidation((address,address,uint24,int24,address),address,uint256)":{"notice":"Executes a forced liquidation of an underwater position."},"getHookTVL(address)":{"notice":"Returns the total value locked within the hook for a specific currency."},"getSwappableCapacity(address)":{"notice":"Returns the immediately swappable liquidity (capacity) of the hook."},"getTotalCollateralUSD()":{"notice":"Returns a real protocol-wide collateral aggregate in USD."},"getTotalDebtUSD()":{"notice":"Returns a real protocol-wide borrow aggregate in USD."},"liquidationThresholdBps(uint8)":{"notice":"Returns the dynamic liquidation threshold for a position in basis points of collateralization."},"positionCurrencies((address,address,uint24,int24,address),address)":{"notice":"Resolves the collateral and debt currencies for a trader's position."},"registerSolverDebt(bytes32,address,address,uint256)":{"notice":"Registers solver debt when a leveraged margin position is opened. The solver physically settled the borrowed leg inside the router's unlock callback; this registry guarantees its repayment (principal + yield) before the trader can withdraw on close/liquidation."},"seedInsuranceFund(address,uint256)":{"notice":"Seed the insurance fund using physical ERC20s, converting them to 6909s."},"setBaseCurrency(bytes32,address)":{"notice":"Configures the base (underlying) token for a pool."},"setDefaultMaxLeverage(uint8)":{"notice":"Updates the global default maximum leverage."},"setMaxLeverageForPool(bytes32,uint8)":{"notice":"Sets the maximum leverage allowed for a specific pool."},"setMaxPriceSwingBps(uint160)":{"notice":"Adjusts the TWAP circuit-breaker tolerance."},"setRequireTwapOracle(bool)":{"notice":"[FIX H-1] Toggle mandatory TWAP o