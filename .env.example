# --- V4 / Unichain ---
UNICHAIN_RPC_URL=<unichain-mainnet-rpc-url>
UNICHAIN_SEPOLIA_RPC_URL=<unichain-sepolia-rpc-url>
V4_HOOK_ADDRESS=<hook-contract>
V4_ROUTER_ADDRESS=<router-contract>
V4_KEEPER_ADDRESS=<liquidation-keeper-contract>
V4_ADAPTER_ADDRESS=<leveraged-aggregator-adapter-contract>
V4_QUOTER_ADDRESS=<leveraged-quoter-contract>
V4_SETTLEMENT_ADDRESS=<cow-settlement-contract>
V4_PRICEFEED_ADDRESS=<v4-pricefeed-contract>

# --- Unichain Sepolia pipeline (DeployUnichainSepoliaFull.s.sol) ---
# Set BOTH to wire the 3 pipeline contracts to an EXISTING Sepolia hook/router
# (mode 2). Leave unset for a fresh full-stack deployment (mode 1).
UNICHAIN_SEPOLIA_HOOK_ADDRESS=<existing-sepolia-hook-contract>
UNICHAIN_SEPOLIA_ROUTER_ADDRESS=<existing-sepolia-router-contract>
# Canonical CoW Protocol GPv2Settlement (deterministic address on every CoW
# chain incl. Sepolia): 0x9008D19f58AAbD9eD0D60971565AA8510560ab41
COW_GPv2_SETTLEMENT=0x9008D19f58AAbD9eD0D60971565AA8510560ab41

# --- Aggregator take-side APIs (for real-quote fixtures + readiness report) ---
# 0x Swap API mainnet is key-gated (free self-serve key: https://dashboard.0x.org)
ZERO_X_API_KEY=<0x-mainnet-api-key>
# Enso Finance (free self-serve key: https://developers.enso.build)
ENSO_API_KEY=<enso-api-key>
# 1inch Swap API (free self-serve key: https://portal.1inch.dev)
ONEINCH_API_KEY=<oneinch-api-key>
# OpenOcean / ODOS / ParaSwap aggregators are keyless — no env needed.

# =============================================================================
# DEMAND SIDE — AGGREGATORS (Enso · Odos · Bungee · Jumper · 1inch)
# =============================================================================
# Verified Unichain (chain 130) exchange-proxy addresses. All OPTIONAL: a venue
# with no address is reported PENDING and is NOT whitelisted.
# A whitelisted proxy is invoked with the FULL swap notional pre-approved, so
# only set addresses you have verified for Unichain.
# Report / register:  node javascript/v4/realApis/registerAggregators.js --dry-run
AGG_ENSO_PROXY_ADDRESS=<enso-router-v2-unichain>
AGG_ODOS_PROXY_ADDRESS=<odos-router-unichain>
AGG_BUNGEE_PROXY_ADDRESS=<bungee-settlement-unichain>
AGG_JUMPER_PROXY_ADDRESS=<lifi-diamond-or-proxy-unichain>
AGG_ONEINCH_ROUTER_ADDRESS=<1inch-router-unichain>

# --- Intent / solver-side (CoW) ---
# ETH mainnet RPC used by the real-API probes and mainnet fork tests.
ETH_MAINNET_RPC_URL=<eth-mainnet-rpc-url>
# Solver/relayer bot private keys for the CoW intent stack.
SOLVER_PRIVATE_KEY=<solver-intent-key>
RELAYER_PRIVATE_KEY=<erc7683-relayer-key>
BRIDGE_PRIVATE_KEY=<aggregator-cow-bridge-key>

# =============================================================================
# SUPPLY SIDE — SOLVER NETWORKS (CoW · UniswapX · Across · 1inch Fusion)
# =============================================================================
# All slots below are OPTIONAL. A venue with any required slot unset reports
# PENDING and REFUSES to route — nothing is hard-coded and nothing is guessed.
# A settlement address is invoked with the FULL swap notional pre-approved, so
# only supply addresses you have verified for Unichain (chain 130).
# Check status at any time:  cd scripts && npm run venues:report

# CoW Protocol — EswapCoWSettlement (falls back to V4_SETTLEMENT_ADDRESS usage)
COW_SETTLEMENT_ADDRESS=<eswap-cow-settlement-contract>
COW_API_URL=https://api.cow.fi

# UniswapX — destination settler + Dutch-auction reactor
UNISWAPX_SETTLEMENT_ADDRESS=<uniswapx-settlement-contract>
UNISWAPX_REACTOR_ADDRESS=<uniswapx-reactor-contract>
UNISWAPX_PERMIT2_ADDRESS=<uniswapx-permit2-contract>
UNISWAPX_API_URL=<uniswapx-orderbook-url>

# Across Relayers — SpokePool cross-chain intents
ACROSS_SETTLEMENT_ADDRESS=<erc7683-settlement-contract>
ACROSS_SPOKE_POOL_ADDRESS=<across-spokepool-contract>
ACROSS_API_URL=<across-relay-api-url>

# 1inch Fusion — resolver auction
ONEINCH_FUSION_SETTLEMENT_ADDRESS=<erc7683-settlement-contract>
ONEINCH_FUSION_API_URL=<1inch-fusion-api-url>

# --- Inventory-based venue settlers (deploy-script opt-in) ---
# UniswapX and 1inch Fusion CANNOT settle by opening a position: their
# protocols require the filler to deliver output tokens to the order recipient,
# which cannot represent an Eswap position. Both are therefore inventory-based
# fill sources, and the deploy script only creates them when ALL slots below are
# set (otherwise it logs [PENDING]). Leave unset until every value is verified
# on the target chain: the reactor/LOP allowance is capped at *_MAX_FILL.
UNISWAPX_SETTLEMENT_INPUT_TOKEN=<token-the-reactor-pulls>
UNISWAPX_SETTLEMENT_OUTPUT_TOKEN=<token-we-deliver>
UNISWAPX_SETTLEMENT_MAX_FILL=<max-output-per-fill-in-wei>
ONEINCH_FUSION_LOP_ADDRESS=<1inch-limit-order-protocol-contract>
ONEINCH_FUSION_MAKER_ASSET=<maker-asset>
ONEINCH_FUSION_TAKER_ASSET=<taker-asset>
ONEINCH_FUSION_MAX_FILL=<max-fill-in-wei>
# Operator allowed to call fill() on both venue settlers. Unset keeps the
# deployer (the broadcasting EOA) as operator.
SETTLEMENT_OPERATOR_ADDRESS=<operator-eoa>
# Address that receives UniswapX fills. validate() requires
# output.recipient == pendingRecipient, so leaving this UNSET makes every
# UniswapX order revert with UnauthorizedRecipient.
UNISWAPX_SETTLEMENT_RECIPIENT=<fill-recipient>

# --- Cross-chain relayer origins (UniswapX / Across fill path) ---
ORIGIN_RPC_1=<ethereum-mainnet-rpc-url>
ORIGIN_RPC_42161=<arbitrum-one-rpc-url>
ORIGIN_RPC_8453=<base-rpc-url>
ORIGIN_SETTLER_1=<erc7683-origin-settler-on-ethereum>
ORIGIN_SETTLER_42161=<erc7683-origin-settler-on-arbitrum>
ORIGIN_SETTLER_8453=<erc7683-origin-settler-on-base>
